# ─────────────────────────────────────────────────────────────
#  Paragon Web Studio — Environment Variables
#  Copy this file to `.env.local` (never commit .env.local)
# ─────────────────────────────────────────────────────────────

# ── Google OAuth (existing auth system) ──────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── Google Analytics 4 ───────────────────────────────────────
# Get from: https://analytics.google.com → Admin → Data Streams
# Uncomment the GA script block in public/index.html, then set:
REACT_APP_GA_ID=G-XXXXXXXXXX

# ── Contact Form Endpoint ────────────────────────────────────
# Options: Formspree (https://formspree.io), Netlify Forms, custom API
# Replace the placeholder in ContactSection.jsx handleSubmit
REACT_APP_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# ── Calendly URL ─────────────────────────────────────────────
# Used for all "Book a Call" CTAs (also set in src/data/paragon.js)
REACT_APP_CALENDLY_URL=https://calendly.com/paragonweb/strategy

# ── API Base URL (if connecting to backend) ──────────────────
REACT_APP_API_BASE_URL=http://localhost:8000
